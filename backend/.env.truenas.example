# ==============================================================================
# PictoHabla Backend — Variables de Entorno para TrueNAS SCALE 25.10.7
# ==============================================================================
# Instrucciones de uso en TrueNAS SCALE:
# 1. Copia este archivo a /mnt/Datos/PictoHabla/.env con permisos 600:
#      cp .env.truenas.example /mnt/Datos/PictoHabla/.env && chmod 600 /mnt/Datos/PictoHabla/.env
# 2. Genera contraseñas criptográficas seguras:
#      openssl rand -hex 32
# 3. NUNCA subas el archivo con valores reales a Git.
# ==============================================================================

# Perfil activo de Spring Boot (producción)
SPRING_PROFILES_ACTIVE=prod

# Base de Datos PostgreSQL 16
DB_NAME=pictohabla
DB_USER=pictohabla_app
# Generar con: openssl rand -hex 32
DB_PASSWORD=<CONTRASEÑA_BD_SEGURA_GENERADA_CON_OPENSSL>

# Seguridad JWT (JSON Web Tokens)
# Clave HMAC-SHA256 de mínimo 256 bits (64 caracteres hexadecimales)
# Generar con: openssl rand -hex 32
JWT_SECRET=<CLAVE_JWT_HEX_64_CHARS_GENERADA_CON_OPENSSL>
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Control de Orígenes CORS (Dominios autorizados separados por comas)
CORS_ALLOWED_ORIGINS=https://pictohabla.local,https://<TU_DOMINIO_PUBLICO>

# URL Pública de la API expuesta a través de Cloudflare Tunnel
PUBLIC_API_URL=https://api.<TU_DOMINIO_PUBLICO>

# Subred de Confianza de Cloudflare Tunnel en TrueNAS SCALE
# Subred real del contenedor ix-cloudflared-cloudflared-1 (red ix-cloudflared_default)
# Verificar con: docker network inspect ix-cloudflared_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXY_SUBNET=172.16.1.0/24

# Verificación de Correo Electrónico (false para arranque inicial sin SMTP)
# Si es false, los profesores quedan activos inmediatamente tras registrarse.
EMAIL_VERIFICATION_REQUIRED=false

# Servidor SMTP Transaccional (Opcional - dejar en blanco si no se usa)
# Cuando no está configurado, el servicio maneja el fallback de forma segura:
# - El registro de profesores opera sin confirmación por email (protegido por rate-limiter: 10/hora).
# - /auth/forgot-password responde 200 OK genérico (anti-enumeración) y registra aviso en log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@<TU_DOMINIO_PUBLICO>

# Clave opcional para cifrado simétrico GPG de copias de seguridad (.dump.gpg)
# Si se deja vacía, los backups se guardan en formato nativo pg_dump .dump
BACKUP_ENCRYPTION_KEY=
