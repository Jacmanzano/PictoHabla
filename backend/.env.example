# ========================================================
# PictoHabla Backend - Variables de Entorno (Plantilla)
# ========================================================
# Copia este archivo como .env para desarrollo local:
# cp .env.example .env

# Perfil de Spring (dev o prod)
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor
SERVER_PORT=8080

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pictohabla
DB_USER=pictohabla
DB_PASSWORD=pictohabla_secret_change_in_prod

# Clave secreta para firma de JSON Web Tokens (mínimo 256 bits en hexadecimal o base64)
# Generar una segura para producción: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Seguridad y Cookies (true en producción con HTTPS)
SECURITY_COOKIE_SECURE=false
EMAIL_VERIFICATION_REQUIRED=false

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
