# ==============================================================================
# PictoHabla Backend — Variables de Entorno para TrueNAS SCALE 25.10.7
# ==============================================================================
# Instrucciones de uso en TrueNAS SCALE:
# 1. Copia este archivo a /mnt/Datos/Aplicaciones/PictoHabla/.env con permisos 600:
#      cp .env.truenas.example /mnt/Datos/Aplicaciones/PictoHabla/.env && chmod 600 /mnt/Datos/Aplicaciones/PictoHabla/.env
# 2. Genera contraseñas criptográficas seguras:
#      openssl rand -hex 32
# 3. NUNCA subas el archivo con valores reales a Git.
# ==============================================================================

# Perfil activo de Spring Boot (producción)
SPRING_PROFILES_ACTIVE=prod

# Base de Datos PostgreSQL 16
DB_NAME=pictohabla
DB_USER=pictohabla_app
# Generar con: openssl rand -hex 32
DB_PASSWORD=<CONTRASEÑA_BD_SEGURA_GENERADA_CON_OPENSSL>

# Seguridad JWT (JSON Web Tokens)
# Clave HMAC-SHA256 de mínimo 256 bits (64 caracteres hexadecimales)
# Generar con: openssl rand -hex 32
JWT_SECRET=<CLAVE_JWT_HEX_64_CHARS_GENERADA_CON_OPENSSL>
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Control de Orígenes CORS (Dominios autorizados sin barra final separados por comas)
# OBLIGATORIO: especificar el dominio real público (sin valores por defecto .local)
CORS_ALLOWED_ORIGINS=https://<TU_DOMINIO_PUBLICO>

# URL Pública de la API expuesta a través de Cloudflare Tunnel
# OBLIGATORIO: especificar la URL pública real (sin valores por defecto .local)
PUBLIC_API_URL=https://api.<TU_DOMINIO_PUBLICO>

# IP de Confianza del Proxy Cloudflare Tunnel en TrueNAS SCALE
# IP fija real del contenedor ix-cloudflared-cloudflared-1 en ix-cloudflared_default
TRUSTED_PROXY_IP=172.16.1.2

# Registro Público de Profesores (false = desactivado en producción por defecto)
# Evita la creación no autorizada de cuentas por internet.
TEACHER_REGISTRATION_ENABLED=false

# Verificación de Correo Electrónico (false para arranque inicial sin SMTP)
EMAIL_VERIFICATION_REQUIRED=false

# Servidor SMTP Transaccional (Opcional - dejar en blanco si no se usa)
# Cuando no está configurado, /auth/forgot-password rechaza la solicitud de forma
# transparente y segura con HTTP 503 (Service Unavailable) sin generar tokens huérfanos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Clave opcional para cifrado simétrico GPG de copias de seguridad (.dump.gpg)
# Si se deja vacía, los backups se guardan en formato nativo pg_dump .dump
BACKUP_ENCRYPTION_KEY=
