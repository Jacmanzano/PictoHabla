# ==============================================================================
# PictoHabla Backend — Variables de Entorno para TrueNAS SCALE 25.10.7
# ==============================================================================
# Instrucciones de uso en TrueNAS SCALE:
# 1. Copia este archivo como .env en /mnt/Datos/PictoHabla/.env (permisos 600)
# 2. Genera contraseñas criptográficas con: openssl rand -hex 32
# 3. NUNCA subas el archivo con valores reales a Git.
# ==============================================================================

# Perfil de Spring Boot
SPRING_PROFILES_ACTIVE=prod

# Base de Datos PostgreSQL 16
DB_NAME=pictohabla
DB_USER=pictohabla_app
# Generar con: openssl rand -hex 32
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_SUPER_SEGURA_POSTGRESQL

# Seguridad JWT (JSON Web Tokens)
# Clave HMAC-SHA256 de mínimo 256 bits (64 caracteres hexadecimales)
# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTA_CLAVE_HEXADECIMAL_DE_64_CARACTERES_PARA_JWT_PROD
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Control de Orígenes CORS (Dominios web autorizados separados por coma)
CORS_ALLOWED_ORIGINS=https://pictohabla.local,https://app.tudominio.com

# URL Pública de la API expuesta a través de Cloudflare Tunnel
PUBLIC_API_URL=https://api.tudominio.com

# Subred de Confianza de Cloudflare Tunnel en TrueNAS SCALE
# Subred real del contenedor ix-cloudflared-cloudflared-1 (ix-cloudflared_default)
TRUSTED_PROXY_SUBNET=172.16.1.0/24

# Verificación de Correo Electrónico (true si configuras SMTP)
EMAIL_VERIFICATION_REQUIRED=false

# Servidor SMTP Transaccional (Opcional si EMAIL_VERIFICATION_REQUIRED=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tudominio.com

# Clave opcional para cifrado simétrico GPG de copias de seguridad
# Si se deja vacía, los backups se guardan en formato nativo pg_dump .dump sin cifrar adicional
BACKUP_ENCRYPTION_KEY=
